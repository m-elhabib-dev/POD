    <color name="mocha_surface1">#FF45475A</color>
    <color name="mocha_text">#FFCDD6F4</color>
    <color name="mocha_subtext0">#FFA6ADC8</color>
    <color name="mocha_mauve">#FFCBA6F7</color>
