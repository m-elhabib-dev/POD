<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape only (see AndroidManifest.xml). drift_container holds BOTH
    the mountains background and the clock/date -- the whole scene nudges
    together for burn-in protection, not just the clock text, since the
    background is now the dominant lit area on screen (see aod-design.md
    "Visual style" trade-off on moving off true-black).

    drift_container is oversized vs. its FrameLayout parent (match_parent
    + 1.1x scale) so a drift offset never exposes a blank edge; the
    parent's default clipChildren keeps the overflow hidden.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aod_background">

    <FrameLayout
        android:id="@+id/drift_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleX="1.1"
        android:scaleY="1.1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_mountains"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="@color/aod_foreground"
                android:textSize="88sp"
                android:fontFamily="monospace" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:format12Hour="EEE, MMM d"
                android:format24Hour="EEE, MMM d"
                android:textColor="@color/aod_foreground_dim"
                android:textSize="20sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
